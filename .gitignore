# ==================================================================== #
# DMKPD 项目 .gitignore
#
# 设计原则：**只跟踪代码 + 少量稳定产物**。
# 数据、权重、训练产物体积大（合计 ~7 GB），走手动/网盘同步，不进 git。
#
# 实测体积（2026-10-11）：
#   .venv          5.58 GB   -> 忽略（新机重建）
#   DMKPD_dataset  1.09 GB   -> 忽略（手动拷），但 splits/ 例外（见下）
#   work_dirs      1.07 GB   -> 忽略
#   modelbase_test 0.30 GB   -> 忽略（手动拷）
#   open-mmlab     0.03 GB   -> 忽略（独立 git 仓库，用 patches/ 同步）
#   det_dataset    0.01 GB   -> **跟踪**（仅 4 个 json，保证标注一致）
# ==================================================================== #

# ---------------------------------------------------------------- #
# 虚拟环境（新机用 requirements-lock.txt 重建，10 分钟）
# ---------------------------------------------------------------- #
.venv/

# ---------------------------------------------------------------- #
# mmpose 源码
#
# ⚠️ `open-mmlab/mmpose` 是一个**独立的 git clone**（HEAD=759b39c1，
#    无 remote），自带 .git。我们的 5 个文件改动（DMKPD_dataset 注册、
#    CheckKeypointOutOfBounds、元信息）通过 `patches/` 目录以 patch
#    形式跟踪，而不是把整个 mmpose 塞进本项目仓库。
#
#    这样做的理由：
#      · mmpose 有 2289 个文件，跟踪它会让每个 commit 都很难看
#      · mmpose 自带 .git，外层 git 会把它当成 gitlink，产生警告
#      · patch 只有 41 KB，可读、可 diff、可 review
# ---------------------------------------------------------------- #
open-mmlab/

# ---------------------------------------------------------------- #
# ❗mmdet 是一个 junction（Windows 目录联接），指向
#    `.venv/Lib/site-packages/mmdet`
#
#    **实测踩过**：漏写这一行时，git 会**穿透 junction** 把
#    site-packages 里 mmdet 的 1466 个文件全部加进版本控制！
#    （被跟踪文件数从 54 暴涨到 1520）
#
#    而且 git 对 junction 的处理很危险：删除 junction 时可能
#    连带删除**目标目录**的真实内容。
#
#    注意 `mmdet/` 与 `mmdet*` 的区别：后者会误伤 `mmdet_xxx.py`
#    之类的文件，所以精确写 `mmdet/`（带斜杠 = 只匹配目录）。
# ---------------------------------------------------------------- #
mmdet/

# ---------------------------------------------------------------- #
# 数据集（1.09 GB，手动拷到新机）
#
# ⚠️ 但 `splits/` 例外：它是**实验可复现性的关键**。
#    train.txt / val.txt 由 make_split.py 生成（seed=42），
#    如果两份代码不同或种子变了，划分就变了，两次实验无法比较。
#    所以这两个几 KB 的清单**必须进 git**。
# ---------------------------------------------------------------- #
DMKPD_dataset/**
!DMKPD_dataset/splits/
DMKPD_dataset/splits/**
!DMKPD_dataset/splits/*.txt

# ---------------------------------------------------------------- #
# 预训练权重（0.30 GB，手动拷）
# ---------------------------------------------------------------- #
modelbase_test/

# ---------------------------------------------------------------- #
# 训练产物（1.07 GB）
#   work_dirs/dmkpd/best_coco_AP_epoch_5.pth            245 MB（本机推理要用）
#   work_dirs/dmkpd/epoch_5.pth                         731 MB（含优化器状态）
#   新机只需 best_*.pth；续训才需 epoch_*.pth
# ---------------------------------------------------------------- #
work_dirs/

# ---------------------------------------------------------------- #
# 可视化产物（0.02 GB，随时可重新生成）
# ---------------------------------------------------------------- #
vis_out2/

# ---------------------------------------------------------------- #
# 提交文件（300 个 txt，每次导出都重新生成）
#
# 不进 git 的理由：换一次检测器，300 个文件全变，diff 会淹没真正
# 有价值的代码改动。若需留存历史版本，用带时间戳的目录另存：
#   Copy-Item submission "submission_$(Get-Date -f yyyyMMdd_HHmm)"
# ---------------------------------------------------------------- #
submission/

# ---------------------------------------------------------------- #
# 迁移包
# ---------------------------------------------------------------- #
*.zip
*.tar.gz
*.7z

# ---------------------------------------------------------------- #
# 临时诊断输出（每次跑诊断脚本都会重新生成）
#
# 注意 patterns 写法：`*_out.txt` 会匹配根目录下所有以 _out.txt
# 结尾的文件，如 `_train_out.txt` / `_det_train_out.txt` /
# `_step_out.txt` / `_env_out.txt` 等，约 25 个。
#
# `*_out2.txt` 要单独写！`*_out.txt` **匹配不到** `_rt_out2.txt`
# （实测踩过：`_rt_out2.txt` 被漏进来跟踪了）。
# ---------------------------------------------------------------- #
*_out.txt
*_out2.txt
*_out3.txt
*_stdout.txt
_dbg_*.txt
_tmp_*.txt
_temp_*.txt
geo_err.txt
loss_curve.json

# ---------------------------------------------------------------- #
# Python
# ---------------------------------------------------------------- #
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
.eggs/
build/
dist/
pip-wheel-metadata/
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.tox/

# ---------------------------------------------------------------- #
# IDE / 编辑器
# ---------------------------------------------------------------- #
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# ---------------------------------------------------------------- #
# 操作系统
# ---------------------------------------------------------------- #
Thumbs.db
Desktop.ini
ehthumbs.db
.DS_Store
