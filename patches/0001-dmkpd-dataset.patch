+
+    def _report_skipped_instances(self, num_valid: int) -> None:
+        """姹囨€讳笂鎶ユ湰娆″墧闄ゆ帀鐨勫紓甯稿疄渚嬨€?+
+        寮傚父瀹炰緥锛堢偣鏁颁笉绛変簬 4锛変細琚潤榛樿烦杩囷紝鑻ヤ笉涓婃姤锛岃缁冩椂鏃犳硶瀵熻
+        鏍囨敞璐ㄩ噺闂銆傝繖閲屾寜銆屽師鍥?-> 瀹炰緥鏁般€嶈仛鍚堝悗鎵撳嵃涓€鏉℃棩蹇楋紝骞舵妸
+        鏄庣粏鍐欏埌 ``out_dir``锛堣嫢鎸囧畾锛夈€?+
+        Args:
