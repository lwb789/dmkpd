+
+        # 鍓嶉潰 10 涓紓甯稿疄渚嬬殑鏄庣粏锛屼究浜庡畾浣嶆爣娉ㄩ棶棰?+        head = self._skipped_instances[:10]
+        for ann_file, gid, reason in head:
