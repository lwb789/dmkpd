+# Copyright (c) OpenMMLab. All rights reserved.
+"""本数据集专用的数据变换。
+
+放在 ``DM`` 包内，随 ``mmpose.datasets.datasets`` 一起被 import，
+因此在 config 里直接写 ``type='...'`` 即可，无需额外 import。
+"""
+import os
+import os.path as osp
+from typing import Optional
+
+import numpy as np
+from mmcv.transforms import BaseTransform
+from mmengine.logging import print_log
+
+from mmpose.registry import TRANSFORMS
+
+__all__ = ['CheckKeypointOutOfBounds']
+
+
+@TRANSFORMS.register_module()
+class CheckKeypointOutOfBounds(BaseTransform):
+    """检查 ``TopdownAffine`` 之后是否有角点被裁出画面，并记录日志。
+
+    为什么需要它
+    ------------
+    ``TopdownAffine`` 把 bbox 区域裁切并缩放到 ``input_size``，窗口大小由
+    ``padding * bbox_scale`` 决定（见 ``get_warp_matrix``，当
+    ``fix_aspect_ratio=True`` 时窗口是边长 ``padding*w`` 的正方形）。
+    如果 ``RandomBBoxTransform`` 的缩放/旋转幅度过大，角点会落到窗口之外。
+
+    窗口能容纳目标的数学约束为（``w``、``h`` 为 bbox 宽高，``θ`` 为旋转角）：:
+
+        (w·|cosθ| + h·|sinθ|) / max(w, h)  <=  padding · s
+
+    最坏情况（正方形、θ=45°）右侧需 ``sqrt(2) = 1.4142``。
+    也就是说 ``padding * scale_factor[0] >= 1.4142`` 必须成立。
+
+    出界的后果
+    ----------
+    mmpose 的 ``generate_gaussian_heatmaps`` 有两种分支：
+
+    * 高斯 3σ 窗口**完全**在画面外 -> ``keypoint_weights = 0``（无害）
+    * 高斯窗口**部分**在画面外 -> 权重仍为 1，却只画出一个被裁掉的高斯
+      （轻度标签噪声：惩罚模型在它看不到的位置产生响应）
+
+    本变换把"出界角点"的 ``keypoints_visible`` 显式置 0，使 codec 走
+    "完全跳过 + 权重 0"的安全分支，**不会产生负监督**；同时把出界明细写入
+    日志文件，便于事后核查增强参数是否过激。
+
+    为什么**不删除实例**
+    --------------------
+    一个实例有 4 个角点，出界 1 个时其余 3 个仍是有效监督信号；
+    删除整个实例（或返回 ``None`` 触发 refetch）会浪费数据，并让 epoch
+    耗时变得不可预测。实测在推荐参数下出界率约 0.07%，影响可忽略。
+
+    Required Keys:
+        - transformed_keypoints
+        - input_size
+        - keypoints_visible
+
+    Modified Keys:
+        - keypoints_visible (出界角点置 0)
+
+    Args:
+        elapse (float): 边缘安全带宽（像素）。距画面边界小于该值的角点
+            虽未出界，但会被记为"近界"以便观察。默认 1.0。
+        mask_near (bool): 是否也把"近界"角点的 ``keypoints_visible`` 置 0。
+            默认 ``False``（近界角点仍在画面内，监督是合理的，只记录不屏蔽）。
+        out_dir (str, optional): 若指定，出界明细会追加写入
+            ``{out_dir}/oob_keypoints_log.txt``，便于事后查证。默认 ``None``。
+        log_interval (int): 每累计多少个异常实例打印一条 WARNING。默认 50。
+        enabled (bool): 关掉检查的总开关。默认 ``True``。
+    """
+
+    def __init__(self,
+                 elapse: float = 1.0,
+                 mask_near: bool = False,
+                 out_dir: Optional[str] = None,
+                 log_interval: int = 50,
+                 enabled: bool = True) -> None:
+        super().__init__()
+        self.elapse = elapse
+        self.mask_near = mask_near
+        self.out_dir = out_dir
+        self.log_interval = log_interval
+        self.enabled = enabled
+
+        # 运行期统计（每个进程各持一份，因 transform 对象随 dataset 一起
+        # 被 dataloader 的 worker 拷贝）
+        self._num_seen = 0        # 经过本变换的实例数
+        self._num_oob = 0         # 含出界角点的实例数
+        self._num_oob_kpts = 0    # 出界角点总数
+        self._num_near_kpts = 0   # 近界角点总数
+
+    # ------------------------------------------------------------------ #
+    def transform(self, results: dict) -> Optional[dict]:
+        if not self.enabled:
+            return results
+
+        kpts = results.get('transformed_keypoints')
+        # TopdownAffine 在无标签时会填入 np.zeros([])，需要排除
+        if kpts is None or kpts.size == 0:
+            return results
+
+        input_size = results.get('input_size')
+        if input_size is None:
+            return results
+        w, h = int(input_size[0]), int(input_size[1])
+
+        k = np.asarray(kpts[0], dtype=np.float32)[:, :2]  # (K, 2)
+        x, y = k[:, 0], k[:, 1]
+        oob = (x < 0) | (x > w - 1) | (y < 0) | (y > h - 1)
+        near = (~oob) & ((x < self.elapse) | (x > w - 1 - self.elapse) |
+                         (y < self.elapse) | (y > h - 1 - self.elapse))
+        num_oob = int(oob.sum())
+        num_near = int(near.sum())
+
+        self._num_seen += 1
+        if num_oob == 0 and num_near == 0:
+            return results
+
+        if num_oob > 0:
+            self._num_oob += 1
+            self._num_oob_kpts += num_oob
+        self._num_near_kpts += num_near
+
+        # ---- 组装可供事后查证的变换信息 ----
+        def _round(arr):
+            return np.round(np.asarray(arr, dtype=np.float32),
+                            3).tolist() if arr is not None else None
+
+        record = dict(
+            img_id=results.get('img_id'),
+            img_path=results.get('img_path'),
+            data_idx=results.get('idx'),
+            input_size=[w, h],
+            oob_kpt_indices=np.nonzero(oob)[0].tolist(),
+            oob_kpt_xy=_round(k[oob]),
+            near_kpt_indices=np.nonzero(near)[0].tolist(),
+            transformed_keypoints=_round(k),
+            bbox_center=_round(results.get('bbox_center')),
+            bbox_scale=_round(results.get('bbox_scale')),
+            bbox_rotation=_round(results.get('bbox_rotation')),
+        )
+
+        # ---- 1) 明细追加到文件，留作事后查证 ----
+        if self.out_dir:
+            self._append_record(record)
+
+        # ---- 2) 周期性汇总到日志，避免刷屏 ----
+        total_abn = self._num_oob + self._num_near_kpts
+        if total_abn % self.log_interval == 0 or num_oob > 0:
+            print_log(
+                f'[CheckKeypointOutOfBounds] 累计检查 {self._num_seen} 实例，'
+                f'其中 {self._num_oob} 个实例含出界角点'
+                f'（共 {self._num_oob_kpts} 个角点被屏蔽），'
+                f'近界角点 {self._num_near_kpts} 个。'
+                f'当前样本: img_id={record["img_id"]}, '
+                f'出界角点索引={record["oob_kpt_indices"]}, '
+                f'bbox_scale={record["bbox_scale"]}, '
+                f'bbox_rotation={record["bbox_rotation"]}',
+                logger='current',
+                level=30)  # WARNING
+
+        # ---- 3) 屏蔽出界角点，让 codec 走"跳过 + 权重 0"的安全分支 ----
+        mask = oob.copy()
+        if self.mask_near:
+            mask |= near
+        if mask.any():
+            vis = results.get('keypoints_visible')
+            if vis is not None and isinstance(vis, np.ndarray):
+                vis = vis.copy()
+                if vis.ndim == 2:
+                    vis[0, mask] = 0
+                elif vis.ndim == 3:
+                    vis[0, mask, :] = 0
+                results['keypoints_visible'] = vis
+
+        return results
+
+    # ------------------------------------------------------------------ #
+    def _append_record(self, record: dict) -> None:
+        """把一条明细追加写入 ``{out_dir}/oob_keypoints_log.txt``。
+
+        备注：训练时本变换会在多个 dataloader worker 中各持一份，
+        因此在同一文件上可能有并发追加。这里保证"一条记录一次
+        ``write``"，即便行顺序交错也不会丢数据或串行。
+        """
+        import json
+        try:
+            os.makedirs(self.out_dir, exist_ok=True)
+            path = osp.join(self.out_dir, 'oob_keypoints_log.txt')
+            line = json.dumps(record, ensure_ascii=False) + '\n'
+            with open(path, 'a', encoding='utf-8') as f:
+                f.write(line)
+        except Exception as e:  # 日志失败不应中断训练
+            print_log(f'[CheckKeypointOutOfBounds] 写日志失败: {e}',
+                      logger='current',
+                      level=30)
+
+    # ------------------------------------------------------------------ #
+    def __repr__(self) -> str:
+        repr_str = self.__class__.__name__
+        repr_str += f'(elapse={self.elapse}, '
+        repr_str += f'mask_near={self.mask_near}, '
+        repr_str += f'out_dir={self.out_dir}, '
+        repr_str += f'log_interval={self.log_interval}, '
+        repr_str += f'enabled={self.enabled})'
+        return repr_str
