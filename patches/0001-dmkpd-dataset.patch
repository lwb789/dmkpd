+    * 楂樻柉绐楀彛**閮ㄥ垎**鍦ㄧ敾闈㈠ -> 鏉冮噸浠嶄负 1锛屽嵈鍙敾鍑轰竴涓瑁佹帀鐨勯珮鏂?+      锛堣交搴︽爣绛惧櫔澹帮細鎯╃綒妯″瀷鍦ㄥ畠鐪嬩笉鍒扮殑浣嶇疆浜х敓鍝嶅簲锛?+
+    鏈彉鎹㈡妸"鍑虹晫瑙掔偣"鐨?``keypoints_visible`` 鏄惧紡缃?0锛屼娇 codec 璧?+    "瀹屽叏璺宠繃 + 鏉冮噸 0"鐨勫畨鍏ㄥ垎鏀紝**涓嶄細浜х敓璐熺洃鐫?*锛涘悓鏃舵妸鍑虹晫鏄庣粏鍐欏叆
+    鏃ュ織鏂囦欢锛屼究浜庝簨鍚庢牳鏌ュ寮哄弬鏁版槸鍚﹁繃婵€銆?+
+    涓轰粈涔?*涓嶅垹闄ゅ疄渚?*
+    --------------------
+    涓€涓疄渚嬫湁 4 涓鐐癸紝鍑虹晫 1 涓椂鍏朵綑 3 涓粛鏄湁鏁堢洃鐫ｄ俊鍙凤紱
+    鍒犻櫎鏁翠釜瀹炰緥锛堟垨杩斿洖 ``None`` 瑙﹀彂 refetch锛変細娴垂鏁版嵁锛屽苟璁?epoch
+    鑰楁椂鍙樺緱涓嶅彲棰勬祴銆傚疄娴嬪湪鎺ㄨ崘鍙傛暟涓嬪嚭鐣岀巼绾?0.07%锛屽奖鍝嶅彲蹇界暐銆?+
+    Required Keys:
+        - transformed_keypoints
+        - input_size
+        - keypoints_visible
+
+    Modified Keys:
+        - keypoints_visible (鍑虹晫瑙掔偣缃?0)
+
+    Args:
+        elapse (float): 杈圭紭瀹夊叏甯﹀锛堝儚绱狅級銆傝窛鐢婚潰杈圭晫灏忎簬璇ュ€肩殑瑙掔偣
+            铏芥湭鍑虹晫锛屼絾浼氳璁颁负"杩戠晫"浠ヤ究瑙傚療銆傞粯璁?1.0銆?+        mask_near (bool): 鏄惁涔熸妸"杩戠晫"瑙掔偣鐨?``keypoints_visible`` 缃?0銆?+            榛樿 ``False``锛堣繎鐣岃鐐逛粛鍦ㄧ敾闈㈠唴锛岀洃鐫ｆ槸鍚堢悊鐨勶紝鍙褰曚笉灞忚斀锛夈€?+        out_dir (str, optional): 鑻ユ寚瀹氾紝鍑虹晫鏄庣粏浼氳拷鍔犲啓鍏?+            ``{out_dir}/oob_keypoints_log.txt``锛屼究浜庝簨鍚庢煡璇併€傞粯璁?``None``銆?+        log_interval (int): 姣忕疮璁″灏戜釜寮傚父瀹炰緥鎵撳嵃涓€鏉?WARNING銆傞粯璁?50銆?+        enabled (bool): 鍏虫帀妫€鏌ョ殑鎬诲紑鍏炽€傞粯璁?``True``銆?+    """
+
+    def __init__(self,
+                 elapse: float = 1.0,
+                 mask_near: bool = False,
+                 out_dir: Optional[str] = None,
+                 log_interval: int = 50,
+                 enabled: bool = True) -> None:
+        super().__init__()
+        self.elapse = elapse
+        self.mask_near = mask_near
+        self.out_dir = out_dir
+        self.log_interval = log_interval
+        self.enabled = enabled
+
+        # 杩愯鏈熺粺璁★紙姣忎釜杩涚▼鍚勬寔涓€浠斤紝鍥?transform 瀵硅薄闅?dataset 涓€璧?+        # 琚?dataloader 鐨?worker 鎷疯礉锛?+        self._num_seen = 0        # 缁忚繃鏈彉鎹㈢殑瀹炰緥鏁?+        self._num_oob = 0         # 鍚嚭鐣岃鐐圭殑瀹炰緥鏁?+        self._num_oob_kpts = 0    # 鍑虹晫瑙掔偣鎬绘暟
+        self._num_near_kpts = 0   # 杩戠晫瑙掔偣鎬绘暟
+
+    # ------------------------------------------------------------------ #
+    def transform(self, results: dict) -> Optional[dict]:
+        if not self.enabled:
+            return results
+
+        kpts = results.get('transformed_keypoints')
+        # TopdownAffine 鍦ㄦ棤鏍囩鏃朵細濉叆 np.zeros([])锛岄渶瑕佹帓闄?+        if kpts is None or kpts.size == 0:
+            return results
+
+        input_size = results.get('input_size')
+        if input_size is None:
+            return results
+        w, h = int(input_size[0]), int(input_size[1])
+
+        k = np.asarray(kpts[0], dtype=np.float32)[:, :2]  # (K, 2)
+        x, y = k[:, 0], k[:, 1]
+        oob = (x < 0) | (x > w - 1) | (y < 0) | (y > h - 1)
+        near = (~oob) & ((x < self.elapse) | (x > w - 1 - self.elapse) |
+                         (y < self.elapse) | (y > h - 1 - self.elapse))
+        num_oob = int(oob.sum())
+        num_near = int(near.sum())
+
+        self._num_seen += 1
+        if num_oob == 0 and num_near == 0:
+            return results
+
+        if num_oob > 0:
+            self._num_oob += 1
+            self._num_oob_kpts += num_oob
+        self._num_near_kpts += num_near
+
+        # ---- 缁勮鍙緵浜嬪悗鏌ヨ瘉鐨勫彉鎹俊鎭?----
+        def _round(arr):
+            return np.round(np.asarray(arr, dtype=np.float32),
+                            3).tolist() if arr is not None else None
+
+        record = dict(
+            img_id=results.get('img_id'),
+            img_path=results.get('img_path'),
+            data_idx=results.get('idx'),
+            input_size=[w, h],
+            oob_kpt_indices=np.nonzero(oob)[0].tolist(),
+            oob_kpt_xy=_round(k[oob]),
+            near_kpt_indices=np.nonzero(near)[0].tolist(),
+            transformed_keypoints=_round(k),
+            bbox_center=_round(results.get('bbox_center')),
+            bbox_scale=_round(results.get('bbox_scale')),
+            bbox_rotation=_round(results.get('bbox_rotation')),
+        )
+
+        # ---- 1) 鏄庣粏杩藉姞鍒版枃浠讹紝鐣欎綔浜嬪悗鏌ヨ瘉 ----
+        if self.out_dir:
+            self._append_record(record)
+
+        # ---- 2) 鍛ㄦ湡鎬ф眹鎬诲埌鏃ュ織锛岄伩鍏嶅埛灞?----
+        total_abn = self._num_oob + self._num_near_kpts
+        if total_abn % self.log_interval == 0 or num_oob > 0:
+            print_log(
+                f'[CheckKeypointOutOfBounds] 绱妫€鏌?{self._num_seen} 瀹炰緥锛?
+                f'鍏朵腑 {self._num_oob} 涓疄渚嬪惈鍑虹晫瑙掔偣'
+                f'锛堝叡 {self._num_oob_kpts} 涓鐐硅灞忚斀锛夛紝'
+                f'杩戠晫瑙掔偣 {self._num_near_kpts} 涓€?
+                f'褰撳墠鏍锋湰: img_id={record["img_id"]}, '
+                f'鍑虹晫瑙掔偣绱㈠紩={record["oob_kpt_indices"]}, '
+                f'bbox_scale={record["bbox_scale"]}, '
+                f'bbox_rotation={record["bbox_rotation"]}',
+                logger='current',
+                level=30)  # WARNING
+
+        # ---- 3) 灞忚斀鍑虹晫瑙掔偣锛岃 codec 璧?璺宠繃 + 鏉冮噸 0"鐨勫畨鍏ㄥ垎鏀?----
+        mask = oob.copy()
+        if self.mask_near:
+            mask |= near
+        if mask.any():
+            vis = results.get('keypoints_visible')
+            if vis is not None and isinstance(vis, np.ndarray):
