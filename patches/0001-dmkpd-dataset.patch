+        return data_info
+
+    # ------------------------------------------------------------------ #
+    # 閬嶅巻鏈哄埗锛氱洰褰?-> json 鍒楄〃 -> 瀹炰緥绾?data_info
+    # ------------------------------------------------------------------ #
+    def _list_ann_files(self) -> List[str]:
+        """鎶?``self.ann_file`` 瑙ｆ瀽鎴?json 鏂囦欢鍒楄〃銆?+
+        ``_join_prefix`` 宸茬粡鎶?``data_root`` 鎷艰繘鏉ヤ簡锛屾墍浠ヨ繖閲屾嬁鍒扮殑
+        鍙兘鏄互涓嬩笁绉嶄箣涓€锛?+
+        - 涓€涓?*鐩綍**锛堝舰濡?``DMKPD_dataset/train/annotations``锛夛細
+          鍙栧叾涓墍鏈?``*.json``锛屾寜鏂囦欢鍚嶆帓搴忥紱
+        - 涓€涓?``.txt`` **鍒掑垎娓呭崟**锛堢敤浜?train/val 鍒掑垎锛夛細
+          姣忚涓€涓?json 璺緞锛宍`#`` 寮€澶寸殑琛屼笌绌鸿浼氳蹇界暐锛?+          **璺緞鍐欑浉瀵?``data_root``**锛岃繖鏍锋洿鎹㈡暟鎹牴鐩綍鏃舵竻鍗曟棤闇€鏀瑰姩锛?+        - 涓€涓?*鍗曚釜 json** 鏂囦欢銆?+        """
+        if not self.ann_file:
+            return []
+        if osp.isdir(self.ann_file):
+            return sorted(glob(osp.join(self.ann_file, '*.json')))
+        if osp.isfile(self.ann_file):
+            if self.ann_file.endswith('.txt'):
+                return self._read_ann_list(self.ann_file)
+            return [self.ann_file]
+        return []
+
+    def _read_ann_list(self, list_file: str) -> List[str]:
+        """璇诲彇 train/val 鍒掑垎娓呭崟銆?+
+        娓呭崟姣忚鏄竴涓?json 鐨勮矾寰勶紙**鐩稿 ``data_root``**锛夛紝
+        浠?``#`` 寮€澶寸殑琛屼笌绌鸿浼氳蹇界暐锛屼究浜庡湪鏂囦欢閲屽啓娉ㄩ噴銆?+        """
+        rels: List[str] = []
+        with open(list_file, encoding='utf-8') as f:
+            for line in f:
+                line = line.strip()
+                if not line or line.startswith('#'):
+                    continue
+                rels.append(line)
+        if not self.data_root:
+            return rels
+        return [osp.join(self.data_root, r) for r in rels]
+
+    def _load_images_only(self) -> List[dict]:
+        """娌℃湁鏍囨敞鏃讹紙渚嬪娴嬭瘯闆嗭級鐩存帴鏋氫妇鍥剧墖鐩綍銆?""
+        img_root = self.data_prefix.get('img', '')
+        img_files: List[str] = []
+        for ext in ('*.jpg', '*.jpeg', '*.png', '*.bmp'):
+            img_files.extend(glob(osp.join(img_root, ext)))
