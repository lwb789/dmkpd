+    @classmethod
+    def _load_metainfo(cls, metainfo: Optional[dict] = None) -> dict:
+        """璁?mmpose 鐨?metainfo 瑙ｆ瀽鍣ㄧ敓鏁堛€?+
+        ``mmengine.BaseDataset._load_metainfo`` 鍙妸 metainfo 褰撲綔鏅€?dict锛?+        鏃笉鏀寔 ``from_file``锛屼篃涓嶄細琛ュ叏 ``flip_indices`` /
+        ``dataset_keypoint_weights`` 绛夋淳鐢熺礌鏉愩€傝繖閲屾敼鐢?mmpose 鐨?+        :func:`parse_pose_metainfo`锛岃繖鏍?config 閲岀殑
+        ``metainfo=dict(from_file='.../DMKPD_meta.py')`` 鎵嶈兘琚纭鍙栥€?+        """
+        raw = {**cls.METAINFO, **(metainfo or {})}
+        # parse_pose_metainfo 鍙繚鐣欑櫧鍚嶅崟瀛楁锛屼細涓㈡帀 `CLASSES`锛?+        # 鑰?CocoMetric 闇€瑕佸畠 -> 瑙ｆ瀽鍚庤ˉ鍥炴潵
+        classes = raw.get('CLASSES')
+        parsed = parse_pose_metainfo(raw)
+        if classes is not None:
+            parsed['CLASSES'] = classes
