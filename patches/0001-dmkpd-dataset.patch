+                logger='current',
+                level=30)
+
+        out_dir = getattr(self, 'out_dir', None)
+        if out_dir:
+            import os
+            os.makedirs(out_dir, exist_ok=True)
+            log_path = osp.join(out_dir, 'skipped_instances.txt')
+            with open(log_path, 'w', encoding='utf-8') as f:
+                f.write('# 琚墧闄ょ殑寮傚父瀹炰緥锛堟爣娉ㄧ偣鏁颁笉绛変簬 4锛塡n')
+                for reason, cnt in sorted(reasons.items()):
+                    f.write(f'# {reason}: {cnt} 涓猏n')
+                for ann_file, gid, reason in self._skipped_instances:
+                    f.write(f'{ann_file}\tgroup_id={gid}\t{reason}\n')
+            print_log(
+                f'[{type(self).__name__}] 鍓旈櫎鏄庣粏宸插啓鍏?{log_path}',
+                logger='current')
+
+    def parse_data_info(self, raw_data_info: dict) -> List[dict]:
+        """鎶婁竴涓?LabelMe json 鎷嗘垚鑻ュ共鏉″疄渚嬬骇 data_info銆?+
+        杩斿洖 ``list[dict]``锛堣€屼笉鏄崟涓?dict锛夛紝鍥犱负涓€寮犲浘鍙兘鏈夊涓疄渚嬨€?+        """
+        ann_file = raw_data_info.get('ann_file', '')
+        shapes = raw_data_info.get('shapes', []) or []
+
+        # 鍥剧墖鍚嶏細鐢?json 鍚屽悕 .jpg
+        img_name = osp.splitext(osp.basename(ann_file))[0] + '.jpg'
+        img_path = osp.join(self.data_prefix.get('img', ''), img_name)
+
+        width = raw_data_info.get('imageWidth')
+        height = raw_data_info.get('imageHeight')
+        img_shape = (height, width) if height and width else None
+
+        instances: List[dict] = []
+        for group_id, group_shapes in self._group_shapes(shapes).items():
+            keypoints, reason = self._extract_keypoints(group_shapes)
+            if keypoints is None:
+                # 璁板綍琚墧闄ょ殑瀹炰緥锛岀瓑鍏ㄩ儴瑙ｆ瀽瀹屽啀姹囨€讳笂鎶?+                self._skipped_instances.append((ann_file, group_id, reason))
+                continue
+
+            x1, y1 = keypoints[:, 0].min(), keypoints[:, 1].min()
