+        if not self._skipped_instances:
+            print_log(
+                f'[{type(self).__name__}] 鏍囨敞瑙ｆ瀽瀹屾垚锛氭湁鏁堝疄渚?{num_valid} 涓紝'
+                f'鏈彂鐜板紓甯稿疄渚嬨€?,
+                logger='current')
+            return
+
+        # 鎸夊師鍥犺仛鍚?+        reasons: dict = {}
