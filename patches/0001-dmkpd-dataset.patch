+    def _append_record(self, record: dict) -> None:
+        """鎶婁竴鏉℃槑缁嗚拷鍔犲啓鍏?``{out_dir}/oob_keypoints_log.txt``銆?+
+        澶囨敞锛氳缁冩椂鏈彉鎹細鍦ㄥ涓?dataloader worker 涓悇鎸佷竴浠斤紝
+        鍥犳鍦ㄥ悓涓€鏂囦欢涓婂彲鑳芥湁骞跺彂杩藉姞銆傝繖閲屼繚璇?涓€鏉¤褰曚竴娆?+        ``write``"锛屽嵆渚胯椤哄簭浜ら敊涔熶笉浼氫涪鏁版嵁鎴栦覆琛屻€?+        """
