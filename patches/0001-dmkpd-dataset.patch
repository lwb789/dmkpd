+"""DMKPD 数据集（Data Matrix 码关键点检测）。
+
+标注来自 LabelMe：**每个 json 对应一张图**，而一张图里可能存在多个 DM 码，
+实例之间用 ``group_id`` 区分（label 统一都是 ``DPM``）。
+
+因此本类不依赖 ``BaseDataset`` 默认的「单 json + data_list」协议，
+而是自己遍历 ``ann_file`` 指向的**目录**并把每个实例展开为一条 data_info。
+
+**异常实例的剔除**：若某个 ``group_id`` 展开后不是恰好 4 个角点（点数不足
+4，或点数多于 4 —— 后者通常意味着标注时把多个 DM 码错标成了同一个
+``group_id``），则该实例被视为不可用并直接跳过，同时在日志里汇总上报，
+避免异常样本被静默丢弃。
+
+config 中使用的字段（全部是 ``BaseDataset`` 的标准字段）::
+
+    dataset = dict(
+        type='DMKPD_dataset',
+        data_root='DMKPD_dataset',                 # 数据根目录
+        ann_file='train/annotations',              # 相对 data_root 的标注目录
+        data_prefix=dict(img='train/images'),      # 相对 data_root 的图片目录
+        metainfo=dict(from_file='.../DMKPD_meta.py'))
+"""
+
+import os.path as osp
+from glob import glob
+from typing import List, Optional, Tuple
+
+import numpy as np
+from mmengine.dataset import BaseDataset
+from mmengine.fileio import load
+from mmengine.logging import print_log
+
+from mmpose.datasets.datasets.utils import parse_pose_metainfo
+from mmpose.registry import DATASETS
+
+
+@DATASETS.register_module(name='DMKPD_dataset')
+class DMKPD_dataset(BaseDataset):
+    """遍历标注目录，把 LabelMe 标注展开成实例级 ``data_list``。
+
+    约定：每个 ``group_id`` 是一个实例，单个实例由 4 个角点组成。
+    """
+
+    METAINFO = {
+        'dataset_name': 'DMKPD_dataset',
+        'keypoint_info': {
+            0: dict(
+                name='top_left',
+                id=0,
+                color=[255, 128, 0],
+                type='',
+                swap='top_right'),
+            1: dict(
+                name='top_right',
+                id=1,
+                color=[255, 128, 0],
+                type='',
+                swap='top_left'),
+            2: dict(
+                name='bottom_right',
+                id=2,
+                color=[255, 128, 0],
+                type='',
+                swap='bottom_left'),
+            3: dict(
+                name='bottom_left',
+                id=3,
+                color=[255, 128, 0],
+                type='',
+                swap='bottom_right'),
+        },
+        'skeleton_info': {
+            0: dict(link=('top_left', 'top_right'), id=0, color=[0, 255, 0]),
+            1: dict(link=('top_right', 'bottom_right'), id=1, color=[0, 255, 0]),
+            2: dict(
+                link=('bottom_right', 'bottom_left'), id=2, color=[0, 255, 0]),
+            3: dict(link=('bottom_left', 'top_left'), id=3, color=[0, 255, 0]),
+        },
+        'joint_weights': [1.0, 1.0, 1.0, 1.0],
+        'sigmas': [0.1, 0.1, 0.1, 0.1],
+        # CocoMetric 需要 `CLASSES` 来构造 COCO 格式的 categories。
+        # **必须写成 COCO 的 loadCats 结构**（list[dict] 且含 id/name），
+        # 若写成 `['DPM']` 这种字符串列表，xtcocotools 的 createIndex 会报
+        # `TypeError: string indices must be integers`（cat['id']）。
+        # 另外 parse_pose_metainfo 会丢弃非标准键，故由 _load_metainfo
+        # 在解析之后重新塞回去。
+        'CLASSES': [dict(id=1, name='DPM', keypoints=[])],
+    }
+
+    def __init__(self, *args, out_dir: Optional[str] = None, **kwargs):
+        """在调用父类 ``__init__``（会触发 ``load_data_list``）之前把
+        异常实例计数器建好，否则解析过程中无处累加。
+
+        Args:
+            out_dir (str, optional): 若指定，则把被剔除实例的明细写到
+                ``{out_dir}/skipped_instances.txt``，便于事后核对标注质量。
+        """
+        self._skipped_instances: List[Tuple[str, object, str]] = []
+        self.out_dir = out_dir
+        # 实例（标注）全局自增编号。必须在 super().__init__ 之前建好，
+        # 因为父类构造会触发 load_data_list -> parse_data_info 用到它
+        self._next_ann_id = 0
+        super().__init__(*args, **kwargs)
+
+    # ------------------------------------------------------------------ #
+    # metainfo
+    # ------------------------------------------------------------------ #
+    @classmethod
+    def _load_metainfo(cls, metainfo: Optional[dict] = None) -> dict:
+        """让 mmpose 的 metainfo 解析器生效。
+
+        ``mmengine.BaseDataset._load_metainfo`` 只把 metainfo 当作普通 dict，
+        既不支持 ``from_file``，也不会补全 ``flip_indices`` /
+        ``dataset_keypoint_weights`` 等派生素材。这里改用 mmpose 的
+        :func:`parse_pose_metainfo`，这样 config 里的
+        ``metainfo=dict(from_file='.../DMKPD_meta.py')`` 才能被正确读取。
+        """
+        raw = {**cls.METAINFO, **(metainfo or {})}
+        # parse_pose_metainfo 只保留白名单字段，会丢掉 `CLASSES`，
+        # 而 CocoMetric 需要它 -> 解析后补回来
+        classes = raw.get('CLASSES')
+        parsed = parse_pose_metainfo(raw)
+        if classes is not None:
+            parsed['CLASSES'] = classes
+        return parsed
+
+    def get_data_info(self, idx: int) -> dict:
+        """把 pipeline / 模型需要的 metainfo 注入每条 data_info。
+
+        (``BaseCocoStyleDataset`` 也是这样做的，这里保持同样的字段集合。)
+        """
+        data_info = super().get_data_info(idx)
+        for key in ('dataset_name', 'upper_body_ids', 'lower_body_ids',
+                    'flip_pairs', 'dataset_keypoint_weights', 'flip_indices',
+                    'skeleton_links'):
+            if key in self._metainfo:
+                data_info[key] = self._metainfo[key]
+        return data_info
+
+    # ------------------------------------------------------------------ #
+    # 遍历机制：目录 -> json 列表 -> 实例级 data_info
+    # ------------------------------------------------------------------ #
+    def _list_ann_files(self) -> List[str]:
+        """把 ``self.ann_file`` 解析成 json 文件列表。
+
+        ``_join_prefix`` 已经把 ``data_root`` 拼进来了，所以这里拿到的
+        可能是以下三种之一：
+
+        - 一个**目录**（形如 ``DMKPD_dataset/train/annotations``）：
+          取其中所有 ``*.json``，按文件名排序；
+        - 一个 ``.txt`` **划分清单**（用于 train/val 划分）：
+          每行一个 json 路径，``#`` 开头的行与空行会被忽略；
+          **路径写相对 ``data_root``**，这样更换数据根目录时清单无需改动；
+        - 一个**单个 json** 文件。
+        """
+        if not self.ann_file:
+            return []
+        if osp.isdir(self.ann_file):
+            return sorted(glob(osp.join(self.ann_file, '*.json')))
+        if osp.isfile(self.ann_file):
+            if self.ann_file.endswith('.txt'):
+                return self._read_ann_list(self.ann_file)
+            return [self.ann_file]
+        return []
+
+    def _read_ann_list(self, list_file: str) -> List[str]:
+        """读取 train/val 划分清单。
+
+        清单每行是一个 json 的路径（**相对 ``data_root``**），
+        以 ``#`` 开头的行与空行会被忽略，便于在文件里写注释。
+        """
+        rels: List[str] = []
+        with open(list_file, encoding='utf-8') as f:
+            for line in f:
+                line = line.strip()
+                if not line or line.startswith('#'):
+                    continue
+                rels.append(line)
+        if not self.data_root:
+            return rels
+        return [osp.join(self.data_root, r) for r in rels]
+
+    def _load_images_only(self) -> List[dict]:
+        """没有标注时（例如测试集）直接枚举图片目录。"""
+        img_root = self.data_prefix.get('img', '')
+        img_files: List[str] = []
+        for ext in ('*.jpg', '*.jpeg', '*.png', '*.bmp'):
+            img_files.extend(glob(osp.join(img_root, ext)))
+        return [
+            dict(
+                img_path=p,
+                img_id=osp.splitext(osp.basename(p))[0],
+            ) for p in sorted(img_files)
+        ]
+
+    def load_data_list(self) -> List[dict]:
+        """遍历标注目录下所有 json，并展开为实例级 ``data_list``。"""
+        ann_files = self._list_ann_files()
+
+        if not ann_files:
+            return self._load_images_only()
+
+        data_list: List[dict] = []
+        for ann_file in ann_files:
+            raw_data_info = load(ann_file)
+            raw_data_info['ann_file'] = ann_file
+            data_list.extend(self.parse_data_info(raw_data_info))
+
+        self._report_skipped_instances(len(data_list))
+        return data_list
+
+    def _report_skipped_instances(self, num_valid: int) -> None:
+        """汇总上报本次剔除掉的异常实例。
+
+        异常实例（点数不等于 4）会被静默跳过，若不上报，训练时无法察觉
+        标注质量问题。这里按「原因 -> 实例数」聚合后打印一条日志，并把
+        明细写到 ``out_dir``（若指定）。
+
+        Args:
+            num_valid (int): 实际保留的实例数，用于算占比。
+        """
+        if not self._skipped_instances:
+            print_log(
+                f'[{type(self).__name__}] 标注解析完成：有效实例 {num_valid} 个，'
+                f'未发现异常实例。',
+                logger='current')
+            return
+
+        # 按原因聚合
+        reasons: dict = {}
+        for ann_file, gid, reason in self._skipped_instances:
+            reasons[reason] = reasons.get(reason, 0) + 1
+
+        total = num_valid + len(self._skipped_instances)
+        detail = '；'.join(f'{k} {v} 个' for k, v in sorted(reasons.items()))
+        print_log(
+            f'[{type(self).__name__}] 标注解析完成：有效实例 {num_valid} 个，'
+            f'剔除异常实例 {len(self._skipped_instances)} 个'
+            f'（占 {100.0 * len(self._skipped_instances) / max(total, 1):.3f}%）。'
+            f'剔除原因：{detail}',
+            logger='current',
+            level=30)  # logging.WARNING
+
+        # 前面 10 个异常实例的明细，便于定位标注问题
+        head = self._skipped_instances[:10]
+        for ann_file, gid, reason in head:
+            print_log(
+                f'  被剔除: {osp.basename(ann_file)}  group_id={gid}  ({reason})',
+                logger='current',
+                level=30)
+        if len(self._skipped_instances) > len(head):
+            print_log(
+                f'  ... 其余 {len(self._skipped_instances) - len(head)} 个明细略',
+                logger='current',
+                level=30)
+
+        out_dir = getattr(self, 'out_dir', None)
+        if out_dir:
+            import os
+            os.makedirs(out_dir, exist_ok=True)
+            log_path = osp.join(out_dir, 'skipped_instances.txt')
+            with open(log_path, 'w', encoding='utf-8') as f:
+                f.write('# 被剔除的异常实例（标注点数不等于 4）\n')
+                for reason, cnt in sorted(reasons.items()):
+                    f.write(f'# {reason}: {cnt} 个\n')
+                for ann_file, gid, reason in self._skipped_instances:
+                    f.write(f'{ann_file}\tgroup_id={gid}\t{reason}\n')
+            print_log(
+                f'[{type(self).__name__}] 剔除明细已写入 {log_path}',
+                logger='current')
+
+    def parse_data_info(self, raw_data_info: dict) -> List[dict]:
+        """把一个 LabelMe json 拆成若干条实例级 data_info。
+
+        返回 ``list[dict]``（而不是单个 dict），因为一张图可能有多个实例。
+        """
+        ann_file = raw_data_info.get('ann_file', '')
+        shapes = raw_data_info.get('shapes', []) or []
+
+        # 图片名：用 json 同名 .jpg
+        img_name = osp.splitext(osp.basename(ann_file))[0] + '.jpg'
+        img_path = osp.join(self.data_prefix.get('img', ''), img_name)
+
+        width = raw_data_info.get('imageWidth')
+        height = raw_data_info.get('imageHeight')
+        img_shape = (height, width) if height and width else None
+
+        instances: List[dict] = []
+        for group_id, group_shapes in self._group_shapes(shapes).items():
+            keypoints, reason = self._extract_keypoints(group_shapes)
+            if keypoints is None:
+                # 记录被剔除的实例，等全部解析完再汇总上报
+                self._skipped_instances.append((ann_file, group_id, reason))
+                continue
+
+            x1, y1 = keypoints[:, 0].min(), keypoints[:, 1].min()
+            x2, y2 = keypoints[:, 0].max(), keypoints[:, 1].max()
+
+            # 标注里的 flags.visibility 表示该实例的「肉眼可见程度」
+            # （0~1，越小越模糊），本数据集有约 37% 的实例低于 0.3
+            # （来自 adv_final_* 这批对抗样本）。
+            #
+            # 这里**故意不用它给 loss 降权**，原因有二：
+            #
+            # 1. 目标要求模型「在低可见度下也能定位」。visibility 描述的是
+            #    图像难度而非标签可靠度——四点角坐标由 DM 码的刚性结构
+            #    唯一确定，与清晰度无关，实测低可见实例的图案是真实存在的。
+            #    降权等于主动放弃这部分训练信号，与鲁棒性目标相反；
+            #    而评测是无权重地统计全部样本的，训练/评测口径会不一致。
+            # 2. mmpose 的 codec 对 keypoints_visible 有**双语义**：
+            #    `codecs/utils/gaussian_heatmap.py` 中
+            #    `if keypoints_visible[n, k] < 0.5: continue` 会**跳过热力图
+            #    生成**（该通道全 0），而 loss 权重在循环外提前拷贝。
+            #    于是 visibility < 0.5 的点会变成「target 全 0 但权重非 0」，
+            #    即负监督：惩罚模型在该位置产生响应，完全违背本意。
+            #
+            # 因此 keypoints_visible 恒为 1（全可见、全权重），
+            # 而把 visibility 作为独立元信息透传给下游，便于事后做
+            # 「清晰样本 / 低可见样本」的分层评估。
+            visibility = self._extract_visibility(group_shapes)
+
+            x1, y1 = keypoints[:, 0].min(), keypoints[:, 1].min()
+            x2, y2 = keypoints[:, 0].max(), keypoints[:, 1].max()
+            bbox = np.array([[x1, y1, x2, y2]], dtype=np.float32)
+            keypoints_xy = keypoints.astype(np.float32)
+
+            # 该实例的全局唯一编号：用于 CocoMetric 里预测与 GT 的配对。
+            # 用自增计数器保证唯一（img_id 是字符串，不能直接当 ann id）
+            ann_id = self._next_ann_id
+            self._next_ann_id += 1
+            # ⚠️ image_id 必须与 data_sample['img_id'] **完全一致**：
+            # CocoMetric 的 gt_to_coco_json 用 `gt_dict['img_id']` 建
+            # `images[].id`，而标注用 `ann['image_id']`。两者不一致时
+            # COCOeval 找不到匹配，所有指标会变成 -1.00（我踩过这个坑）。
+            # 这里统一用可读的字符串 img_id（xtcocotools 用 dict 索引，
+            # 字符串完全合法）。
+            image_id = osp.splitext(img_name)[0]
+
+            # 面积 = bbox 面积。它是 OKS 的分母（OKS 里的 `area`），
+            # 也是 AP(M)/AP(L) 分段统计的依据。
+            # **不要乘 COCO 那个人体的 0.53 修正系数**——那是对人体
+            # bbox 远大于真实轮廓的补偿，DM 码的 bbox 是紧贴码的
+            # （实测 w/h 中位 1.013），乘了会低估面积。
+            area = float((x2 - x1) * (y2 - y1))
+
+            # CocoMetric 在未提供 ann_file 时，会现场用 raw_ann_info 拼
+            # COCO 格式 json，需要的键见 gt_to_coco_json()：
+            # id / image_id / category_id / bbox / keypoints / iscrowd / area
+            # keypoints 必须是展平的 [x1,y1,v1, x2,y2,v2, ...]（v=2 表示可见）
+            flat_kpts = []
+            for (px, py) in keypoints_xy:
+                flat_kpts.extend([float(px), float(py), 2.0])
+            raw_ann_info = dict(
+                id=ann_id,
+                image_id=image_id,
+                category_id=1,
+                bbox=[float(x1), float(y1), float(x2 - x1),
+                      float(y2 - y1)],  # COCO 是 xywh
+                keypoints=flat_kpts,
+                iscrowd=0,
+                area=area,
+                num_keypoints=int(len(keypoints_xy)),
+            )
+
+            data_info = dict(
+                img_path=img_path,
+                img_id=osp.splitext(img_name)[0],
+                # 以下三个供 CocoMetric 使用（见 CocoMetric.process）
+                id=ann_id,
+                image_id=image_id,
+                category_id=1,
+                iscrowd=0,
+                area=area,
+                raw_ann_info=raw_ann_info,
+                width=width,
+                height=height,
+                bbox=bbox,
+                # top-down 推理时，add_pred_to_datasample 会把
+                # gt_instances.bbox_scores 复制给 pred_instances
+                # （见 pose_estimators/topdown.py），缺了它会 AttributeError。
+                # 注意键名用单数 `bbox_score`，PackPoseInputs 的
+                # instance_mapping_table 会把它映射成多数的 `bbox_scores`
+                bbox_score=np.ones(1, dtype=np.float32),
+                keypoints=keypoints_xy[None],  # (1, K, 2)
+                keypoints_visible=np.ones((1, len(keypoints_xy)),
+                                          dtype=np.float32),
+                group_id=group_id,
+                instance_visibility=visibility,
+            )
+            if img_shape is not None:
+                data_info['img_shape'] = img_shape
+                data_info['ori_shape'] = img_shape
+            instances.append(data_info)
+        return instances
+
+    # ------------------------------------------------------------------ #
+    # 解析辅助函数
+    # ------------------------------------------------------------------ #
+    @staticmethod
+    def _group_shapes(shapes: list) -> dict:
+        """按 ``group_id`` 把 shapes 分组，一组 = 一个 DM 码实例。"""
+        grouped: dict = {}
+        for idx, shape in enumerate(shapes):
+            gid = shape.get('group_id')
+            if gid is None:
+                gid = f'unlabeled_{idx}'
+            grouped.setdefault(gid, []).append(shape)
+        return grouped
+
+    @staticmethod
+    def _extract_visibility(group_shapes: list) -> float:
+        """读取标注里的 ``flags.visibility``，作为该实例的「可见程度」。
+
+        该字段描述的是**图像难度**（DM 码在画面中的清晰/模糊程度），
+        而不是标签可靠度，因此**不用于 loss 加权**（理由见
+        :meth:`parse_data_info`）。这里只把它提取出来作为元信息，
+        供事后做「清晰样本 / 低可见样本」的分层评估。
+
+        数据集实测：约 37% 的实例 ``visibility < 0.3``（来自
+        ``adv_final_*`` 这批对抗样本），最小 0.1073；其余约 0.80~1.00。
+
+        取值规则：
+
+        - 同一 group 内取所有 shape 的 ``visibility``，**按点数加权平均**
+          （正常情况一个 shape 一个值，取平均即退化成该值）；
+        - 没有任何 ``visibility`` 字段时（早期 linestrip 标注、测试集）
+          返回 ``1.0``，即视为完全可见；
+        - 结果裁剪到 ``[0, 1]``，避免标注异常值超出范围。
+
+        Args:
+            group_shapes (list): 同一 ``group_id`` 下的 shape 列表。
+
+        Returns:
+            float: 该实例的可见程度，取值 ``[0, 1]``。
+        """
+        vals = []
+        weights = []
+        for shape in group_shapes:
+            flags = shape.get('flags') or {}
+            if 'visibility' not in flags:
+                continue
+            try:
+                v = float(flags['visibility'])
+            except (TypeError, ValueError):
+                continue
+            n_pts = len(shape.get('points') or [])
+            if n_pts <= 0:
+                continue
+            vals.append(v)
+            weights.append(n_pts)
+
+        if not vals:
+            return 1.0
+
+        v = float(np.average(vals, weights=weights))
+        # 防止标注异常导致超出 [0, 1]
+        return float(min(1.0, max(0.0, v)))
+
+    @staticmethod
+    def _extract_keypoints(
+            group_shapes: list) -> Tuple[Optional[np.ndarray], str]:
+        """把一组 shape 的角点整理成 ``(4, 2)``，顺序为顺时针 TL, TR, BR, BL。
+
+        关键点：LabelMe 里四点只保证「沿顺时针依次相连」，**起点不固定**
+        （可能是 TL/TR/BR/BL 中任意一个），因此不能直接照抄书写顺序，而要
+        自己还原循环顺序。
+
+        还原方式是「绕质心按极角排序」——对凸多边形的 4 个顶点，极角排序
+        得到的正是顶点的循环顺序。这一点比早期用的 ``x+y`` / ``x-y``
+        极值法稳健得多：极值法在方块接近 45° 摆放时会退化（同一个点同时
+        成为两个方向的最值），实测全量数据中有 6.16% 的实例会被排错。
+
+        得到循环顺序后再做两件规范化的事：
+
+        1. **统一环绕方向为顺时针**（图像坐标 y 向下时，有向面积 > 0）；
+        2. **统一起点**：取 ``x + y`` 最小的点作为 ``top_left``。
+
+        这样输出才是确定的，模型才能学到稳定的关键点语义。
+
+        本方法**只接受恰好 4 个角点**的实例。若点数不足 4（例如被拆成
+        多段未补齐），或点数多于 4（通常是标注时把多个 DM 码错标成了同一
+        个 ``group_id``），则视为不可用，返回 ``(None, 原因)`` 由调用方
+        丢弃并上报。注意：这里刻意不做「取凸包/取前 4 个点」之类的猜测性
+        修补，以免把错误标注悄悄变成错误监督信号。
+
+        Returns:
+            tuple: ``(keypoints, reason)``。成功时 ``keypoints`` 为
+            ``(4, 2)`` 的 ``np.ndarray``、``reason`` 为 ``''``；失败时
+            ``keypoints`` 为 ``None``、``reason`` 为剔除原因文本。
+        """
+        points = [
+            pt for shape in group_shapes for pt in (shape.get('points') or [])
+        ]
+        pts = np.asarray(points, dtype=np.float32)
+        if pts.ndim != 2 or pts.shape[0] < 4:
+            return None, f'点数不足4(点数={0 if pts.ndim != 2 else pts.shape[0]})'
+
+        # 去掉首尾重合的闭合点（polygon 常见写法）
+        if np.allclose(pts[0], pts[-1]):
+            pts = pts[:-1]
+
+        if pts.shape[0] > 4:
+            return None, f'点数多于4(去闭合点后点数={pts.shape[0]})'
+        if pts.shape[0] < 4:
+            return None, f'点数不足4(去闭合点后点数={pts.shape[0]})'
+
+        # ① 绕质心按极角排序 -> 还原四边形顶点的循环顺序
+        center = pts.mean(axis=0)
+        angles = np.arctan2(pts[:, 1] - center[1], pts[:, 0] - center[0])
+        pts = pts[np.argsort(angles, kind='stable')]
+
+        # ② 统一环绕方向：令有向面积为正（图像坐标下即为顺时针）
+        x, y = pts[:, 0], pts[:, 1]
+        area = 0.5 * float(
+            np.dot(x, np.roll(y, -1)) - np.dot(y, np.roll(x, -1)))
+        if area < 0:
+            pts = pts[::-1]
+
+        # ③ 统一起点：x+y 最小者视为左上角（并列时再比 x）
+        s = pts[:, 0] + pts[:, 1]
+        start = int(np.lexsort((pts[:, 0], s))[0])
+        return np.roll(pts, -start, axis=0).astype(np.float32), ''
