+
+    def get_data_info(self, idx: int) -> dict:
+        """鎶?pipeline / 妯″瀷闇€瑕佺殑 metainfo 娉ㄥ叆姣忔潯 data_info銆?+
+        (``BaseCocoStyleDataset`` 涔熸槸杩欐牱鍋氱殑锛岃繖閲屼繚鎸佸悓鏍风殑瀛楁闆嗗悎銆?
+        """
